SELECT DISTINCT ?company ?companyLabel ?countryLabel
       ?foundingYearShort
       ?revenue ?revenueYear ?revenueCurrencyLabel
       ?employees ?employeesYear
       ?equity ?equityYear ?equityCurrencyLabel
WHERE {
  # Производители кофе
  ?company wdt:P1056 wd:Q8486.

  OPTIONAL { ?company wdt:P17 ?country. }              # Страна

  # Год основания (только год)
  OPTIONAL { ?company wdt:P571 ?foundingYear. }
  BIND(YEAR(?foundingYear) AS ?foundingYearShort)

  # Выручка с временным контекстом (только год) и валютой
  OPTIONAL {
    ?company p:P2139 ?revenueStatement.
    ?revenueStatement ps:P2139 ?revenue.
    OPTIONAL { ?revenueStatement pq:P585 ?revenueTime. }
    BIND(YEAR(?revenueTime) AS ?revenueYear)           # Только год

    # Извлекаем единицу измерения (валюту)
    ?revenueStatement psv:P2139 ?revenueValue.
    ?revenueValue wikibase:quantityUnit ?revenueCurrency.
    OPTIONAL { ?revenueCurrency wdt:P1813 ?revenueCurrencyLabel. }  # Короткое название валюты
  }

  # Число сотрудников с временным контекстом (только год)
  OPTIONAL {
    ?company p:P1128 ?employeesStatement.
    ?employeesStatement ps:P1128 ?employees.
    OPTIONAL { ?employeesStatement pq:P585 ?employeesTime. }
    BIND(YEAR(?employeesTime) AS ?employeesYear)       # Только год
  }

  # Активы (total equity) с временным контекстом (только год) и валютой
  OPTIONAL {
    ?company p:P2137 ?equityStatement.
    ?equityStatement ps:P2137 ?equity.
    OPTIONAL { ?equityStatement pq:P585 ?equityTime. }
    BIND(YEAR(?equityTime) AS ?equityYear)             # Только год

    # Извлекаем единицу измерения (валюту)
    ?equityStatement psv:P2137 ?equityValue.
    ?equityValue wikibase:quantityUnit ?equityCurrency.
    OPTIONAL { ?equityCurrency wdt:P1813 ?equityCurrencyLabel. }  # Короткое название валюты
  }

  # Метки на русском, английском и других языках
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,mul". }
}
ORDER BY DESC(COALESCE(?revenue, 0))
